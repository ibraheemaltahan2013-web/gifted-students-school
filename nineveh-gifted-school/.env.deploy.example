# Google Cloud Deployment Environment Variables
# Copy this to .env.local and fill in your values

# Google Cloud
GCP_PROJECT_ID=your-project-id-123
GCP_REGION=us-central1

# Database (Cloud SQL PostgreSQL)
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:your-db-password@/nineveh_gifted_school?host=/cloudsql/your-project-id:region:instance-name

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-change-in-production

# Frontend URL (will be updated after deploy)
FRONTEND_URL=https://your-frontend-url.run.app

# Optional: Custom Domain
# CUSTOM_DOMAIN=school.nineveh.edu.iq